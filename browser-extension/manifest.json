{
  "manifest_version": 3,
  "name": "Awareness Memory",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Bring ChatGPT, Doubao, Kimi, DeepSeek and Gemini conversations into your own Awareness memory. Search and recall across tools.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:37800/*",
    "https://awareness.market/*",
    "https://raw.githubusercontent.com/everest-an/Awareness-SDK/*"
  ],
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Awareness Memory",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "permissions": ["storage", "alarms", "identity", "sidePanel", "activeTab"]
}
